# API
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info
DATABASE_URL=postgresql://ta_passando:ta_passando_dev@localhost:5432/ta_passando
CORS_ORIGINS=http://localhost:3000,http://localhost:4173

# Google Identity Platform/Firebase Authentication.
# Exemplo de issuer: https://securetoken.google.com/SEU_PROJECT_ID
OIDC_ISSUER_URL=
OIDC_AUDIENCE=
OIDC_JWKS_URL=https://www.googleapis.com/service_accounts/v1/jwk/securetoken@system.gserviceaccount.com

# Retenção e privacidade
POSITION_TTL_SECONDS=180
PUBLIC_POSITION_GRID_METERS=250
