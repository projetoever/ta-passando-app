{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "pilot": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_DATA_MODE": "simulated",
        "EXPO_PUBLIC_GPS_ENABLED": "false"
      }
    },
    "production": {
      "autoIncrement": true
    }
  }
}

